# SwarmRL WebSocket Relay Configuration

# Host/interface the WebSocket server binds to (default: 0.0.0.0 for server, localhost for clients)
WS_HOST=localhost

# Port the WebSocket server listens on (default: 8080)
WS_PORT=8080

# Complete WebSocket endpoint URL for clients (optional, overrides host/port)
# WS_URL=ws://localhost:8080

# Frontend (Vite) environment overrides
# VITE_WS_URL=ws://localhost:8080
# VITE_WS_PORT=8080
